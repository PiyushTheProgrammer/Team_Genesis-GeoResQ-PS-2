# GeoResQ GEOAI 02 Environment Configuration Example

# Base URL for the GeoAI Inference Backend Server
VITE_API_BASE_URL=http://localhost:8000

# Enable automatic demo data fallback when backend is unreachable (true | false)
VITE_ENABLE_DEMO_FALLBACK=true

# Default Map Viewport Settings (Nashik, Maharashtra)
VITE_MAP_DEFAULT_LAT=20.0059
VITE_MAP_DEFAULT_LNG=73.7898
VITE_MAP_DEFAULT_ZOOM=14
